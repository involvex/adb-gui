{
  "name": "adb-gui",
  "version": "0.0.0",
  "private": true,
  "description": "A GUI for ADB Commands",
  "author": "involvex",
  "type": "module",
  "main": "dist-electron/main.js",
  "bin": {
    "adb-gui": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun vite",
    "prebuild": "bun run format && bun run typecheck && bun run lint:fix",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "format": "prettier . --write",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "start:dev": "vite"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.26",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
